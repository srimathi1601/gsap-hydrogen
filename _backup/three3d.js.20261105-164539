    const C=MOB?CAMM:CAM;const tv=new T.Vector3(),wp=new T.Vector3(),wn=new T.Vector3(),cd=new T.Vector3();let ft=[],last=performance.now();window.__s3dFT=ft;
    const lerp=(a,b,f)=>a+(b-a)*f;
    function frame(){if(!visible||document.hidden)return;const now=performance.now();ft.push(now-last);if(ft.length>240)ft.shift();last=now;
      qp(S.tl.progress()*(S.N-1));const p=st.p,i=Math.min(S.N-2,Math.floor(p)),f=smooth(Math.min(1,p-i));const a=C[i],b=C[i+1];
