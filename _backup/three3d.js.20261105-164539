  gsap.ticker.add(()=>{if(!colEl)return;const idx=S.tl.progress()*(S.N-1),f=idx-Math.floor(idx);colEl.style.opacity=QC?1:(idx>=S.N-1?1:Math.min(1,Math.abs(f-.5)/.18))});
