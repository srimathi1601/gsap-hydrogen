        const s=wp.clone().project(cam);if(s.z>1)ok=false;h.el.style.transform=`translate(${(s.x*.5+.5)*W}px,${(-s.y*.5+.5)*H}px) translate(-50%,-50%)`;h.el.classList.toggle('on',ok)});}
