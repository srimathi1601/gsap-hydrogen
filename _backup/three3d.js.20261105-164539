function initViewer(){const btn=MOB?document.querySelector('.m-3d'):(()=>{const q=[...document.querySelectorAll('[data-k]')];const b=q.find(e=>e.dataset.k.endsWith('/Button / 3D ansehen'));if(!b)return q.find(e=>e.dataset.k.endsWith('/Frame 3/3D ansehen'))?.parentElement;q.forEach(e=>{const k=e.dataset.k;if(k.endsWith('/Frame 3/3D ansehen')||k.endsWith('/Frame 3/Icon / cube'))e.style.pointerEvents='none'});return b})();if(!btn)return;
