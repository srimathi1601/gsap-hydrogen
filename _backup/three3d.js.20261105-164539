function initSection(){const S=window.S3D;if(!S)return;const host=document.getElementById('s3d');
  const box=S.els[MOB?'/Image wrap/Step image':'/Stage/Step image'];if(!box)return;
  const col=S.els['/Stage/Frame 17'];
  // nav clicks: pills, arrows, mobile dots -> scroll to that step (scrubbed motion follows)
  const go=i=>{const t=S.trig;if(!t)return;i=Math.max(0,Math.min(S.N-1,i));const y=t.start+(t.end-t.start)*i/(S.N-1)+1;window.lenis?lenis.scrollTo(y,{duration:1.2}):scrollTo({top:y,behavior:'smooth'})};
  const cur=()=>Math.round(S.tl.progress()*(S.N-1));
  for(let i=0;i<5;i++){const e=S.els[`/Navigator/Row/Tabs/Tab 0${i+1}`]||S.els[`/Navigator/Dots/Dot 0${i+1}`];if(e){e.style.cursor='pointer';e.style.pointerEvents='auto';e.addEventListener('click',()=>go(i))}}
  [['/Navigator/Row/Prev',-1],['/Navigator/Row/Next',1]].forEach(([k,d])=>{const e=S.els[k];if(e){e.style.cursor='pointer';e.style.pointerEvents='auto';e.addEventListener('click',()=>go(cur()+d))}});
