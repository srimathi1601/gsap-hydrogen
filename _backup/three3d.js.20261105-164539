  const cv=document.createElement('canvas');Object.assign(cv.style,{width:'100%',height:'100%',display:'block',touchAction:'pan-y'});wrap.appendChild(cv);box.appendChild(wrap);
  const dots=document.createElement('div');Object.assign(dots.style,{position:'absolute',inset:0,pointerEvents:'none'});wrap.appendChild(dots);
  let started=false,visible=false;
  const io=new IntersectionObserver(es=>es.forEach(e=>{visible=e.isIntersecting;if(visible&&!started){started=true;start()}}),{rootMargin:'900px 0px'});io.observe(host);
