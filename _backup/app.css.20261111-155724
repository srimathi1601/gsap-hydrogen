.m-accs{display:grid;gap:10px;margin-top:10px}.m-acc{display:grid;grid-template-columns:64px 1fr;column-gap:12px;align-items:center;background:#f8f8f8;border:1px solid #eaeaea;border-radius:23px;padding:12px;min-height:44px}
.m-acc input{position:absolute;opacity:0}.m-acc:has(input:checked){border:2px solid #1f1f1f;background:#fff}.m-acc img{grid-row:span 4;width:64px;height:64px;border-radius:12px;object-fit:cover}.m-acc span{font-size:13px;color:#555}.m-sel{color:#1e5fd8!important}
.m-del{display:grid;gap:10px;margin-top:10px}.m-dopt{display:grid;grid-template-columns:44px 1fr auto;gap:10px;align-items:center;text-align:left;background:#f8f8f8;border:1px solid #eaeaea;border-radius:23px;padding:14px;min-height:56px}.m-dopt.on{background:#fff;border:2px solid #1f1f1f}
.m-dopt small{display:block;font-size:13px;color:#555}.m-dopt em{font-style:normal;font-weight:600;text-align:right;font-size:14px}.m-dopt em.g{color:#1e8a3c}
.m-dic{width:44px;height:44px;border-radius:12px;background:#fff;display:inline-flex;align-items:center;justify-content:center}
.m-more{display:inline-flex;min-height:44px;align-items:center;font-weight:600}
.m-fin{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14px}.m-fin small{display:block;color:#555;font-size:13px}.m-fin a{min-height:44px;display:inline-flex;align-items:center;font-weight:600;white-space:nowrap}
.m-total{background:linear-gradient(90deg,#2b4689,#1b2d63);border-radius:28px;color:#fff;padding:18px;margin:16px 0;box-shadow:0 15px 45px rgba(0,0,0,.15)}
.m-trow{display:flex;justify-content:space-between;align-items:center;gap:8px}.m-trow strong{font-size:26px}.m-trow.sm{font-size:13px;margin:6px 0 14px}
.m-cart{width:100%;min-height:56px;border-radius:37px;background:#f4f1e8;color:#1f1f1f;font-weight:600;font-size:16px;display:flex;align-items:center;justify-content:center}
.m-eta{font-size:13px;margin-top:10px;text-align:center}
.m-usp{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px}.m-usp li{display:flex;gap:8px;align-items:center}
.m-secure{font-size:13px;display:flex;gap:6px;align-items:center;margin:10px 0}
.m-tph,.m-room summary{display:flex;gap:10px;align-items:center;list-style:none;min-height:44px}.m-tph small,.m-room small{display:block;font-size:13px;color:#555}.m-tp p{font-size:13px;margin-top:8px}.m-call{font-size:13px;text-align:center}
.m-sec{padding:48px 16px}.m-h{font-size:30px;line-height:1.1;font-weight:600;margin-bottom:20px}.m-sec h3{font-size:18px;margin:24px 0 10px}
.m-score{display:flex;gap:14px;align-items:center}.m-score>b{font-size:56px;line-height:1}.m-score small{display:block;font-size:13px}
.m-bars{list-style:none;margin:14px 0;display:grid;gap:6px;font-size:13px}.m-bars li{display:grid;grid-template-columns:70px 1fr 40px;gap:8px;align-items:center}.m-bars i{height:8px;background:#e6e6e6;border-radius:4px;overflow:hidden}.m-bars em{display:block;height:100%;background:#1f1f1f}
.m-src{font-size:13px;color:#6b6b6b}.m-src.c{text-align:center}
.m-photos{overflow-x:auto;border-radius:16px}.m-photos img{height:120px;width:auto;max-width:none}
.m-chips{display:flex;gap:8px;flex-wrap:wrap}.m-chip,.m-sort,.m-pill{min-height:44px;border-radius:22px;border:1px solid #b9b9b9;padding:0 16px;display:inline-flex;align-items:center;justify-content:center;font-size:14px}
.m-search{display:flex;gap:8px;margin:16px 0}.m-search input{flex:1;min-height:44px;border:1px solid #b9b9b9;border-radius:22px;padding:0 16px;font:inherit;font-size:15px;min-width:0}
.m-rc{background:#f4f4f4;border:1px solid #b9b9b9;border-radius:26px;padding:18px;margin:12px 0}.m-rc header{display:flex;justify-content:space-between;font-size:14px}.m-rc time{color:#6b6b6b;font-size:13px}
.m-ver{display:flex;gap:8px;align-items:center;font-size:13px;margin:6px 0}.m-ver span{display:inline-flex;gap:4px;align-items:center}.m-ver .ic{width:16px;height:16px}.m-rc h4{font-size:16px;margin:6px 0}.m-rc p{font-size:15px}.m-rc img{margin-top:12px;border-radius:12px;max-height:180px;width:auto}
.m-pill{display:flex;margin:20px auto 8px;border-color:#1f1f1f;border-radius:28px;min-height:56px;font-weight:600}
.m-faq details{border-top:1px solid #e0e0e0}.m-faq details:last-child{border-bottom:1px solid #e0e0e0}
.m-faq summary{list-style:none;min-height:64px;display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:17px;font-weight:600;cursor:pointer;padding:12px 0}.m-faq summary::-webkit-details-marker{display:none}
.m-faq summary i{flex:none;width:16px;height:16px;position:relative}.m-faq summary i:before,.m-faq summary i:after{content:'';position:absolute;left:0;top:7px;width:16px;height:2px;background:#1f1f1f;transition:transform .3s}.m-faq summary i:after{transform:rotate(90deg)}.m-faq details[open] summary i:after{transform:rotate(0)}
.m-faq p{padding:0 0 18px;font-size:15px;color:#444}
.m-specs{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px}.m-specs li{background:#f4f4f4;border-radius:26px;padding:16px}.m-specs b{display:block;font-size:20px}.m-specs span{font-size:13px;color:#555}
.m-specimg{margin:16px 0;border-radius:26px;background:#f4f4f4}.m-tbl{width:100%;border-collapse:collapse;font-size:14px}.m-tbl th,.m-tbl td{text-align:left;padding:12px 0;border-bottom:1px solid #e0e0e0;vertical-align:top}.m-tbl th{font-weight:500;color:#555;width:45%}
.m-lead{font-size:15px;color:#444;margin-bottom:16px}.m-box{background:#f3f3f3;border-radius:30px;padding:20px 16px;margin:14px 0}
.m-badge{display:inline-flex;min-height:32px;align-items:center;background:#fff;border-radius:16px;padding:0 12px;font-size:13px;font-weight:600;margin-bottom:10px}
.m-it{display:grid;grid-template-columns:52px 1fr;gap:12px;padding:12px 0}.m-tile{width:52px;height:52px;border-radius:14px;background:#dbdbdb;display:inline-flex;align-items:center;justify-content:center}.m-it p{font-size:14px;color:#444}.m-it a{display:inline-flex;min-height:44px;align-items:center;font-weight:600;margin-right:12px}
.m-optbox{background:#fff;border-radius:16px;padding:10px 12px;margin-top:8px;font-size:13px}.m-optbox small{display:block}.m-optbox em{font-style:normal;color:#1e6bf5}
.m-foot{background:#000;color:#fff;padding:48px 16px 110px}.m-fbig{font-size:28px;line-height:1.15;font-weight:600}.m-news{display:flex;justify-content:space-between;min-height:56px;align-items:center;border-bottom:1px solid #444;text-decoration:none;font-size:17px;margin:16px 0 24px}
.m-fl{font-size:13px;color:#aaa;margin:20px 0 6px;text-transform:uppercase;letter-spacing:.04em}.m-tel{font-size:22px;font-weight:600;text-decoration:none;display:inline-flex;min-height:44px;align-items:center}.m-foot p{font-size:14px}
.m-fcol{border-bottom:1px solid #333}.m-fcol summary{min-height:52px;display:flex;align-items:center;font-weight:600;list-style:none}.m-fcol ul{list-style:none;padding-bottom:10px}.m-fcol a{display:flex;min-height:44px;align-items:center;text-decoration:none;color:#ddd;font-size:15px}
.m-foot img{max-width:100%;height:auto;margin:6px 0;border-radius:6px}.m-legal a{display:inline-flex;min-height:44px;align-items:center;margin-right:14px;font-size:13px;color:#ccc}.m-copy{font-size:13px;color:#888}
#gbar .m-bar{pointer-events:auto;margin:0 10px calc(10px + env(safe-area-inset-bottom));background:#2e2d29;border-radius:40px;display:flex;align-items:center;gap:10px;padding:8px 8px 8px 10px;color:#fff;box-shadow:0 15px 45px rgba(0,0,0,.2)}
#gbar .m-bar img{width:44px;height:44px;border-radius:50%;object-fit:cover;background:#fff}#gbar .m-bar div{flex:1;min-width:0;font-size:13px;line-height:1.3}#gbar .m-bar div *{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#gbar .m-bar button{background:#1e6bf5;color:#fff;border-radius:30px;min-height:48px;padding:0 16px;font-weight:600;font-size:14px;white-space:nowrap}
#gbar{height:auto;transform:translateY(160%)}#gbar.show{transform:none}
}
@media(max-width:767px){.m-logo{min-height:44px;display:inline-flex;align-items:center}.m-note a{display:inline-flex;min-height:44px;align-items:center}.mob small{font-size:13px}}
#gbar{transition:transform .55s cubic-bezier(.16,1,.3,1),opacity .4s ease;opacity:0}#gbar.show{opacity:1}
.m-optbox em,.m-dopt em{white-space:nowrap}
.m-promo{min-height:76px;display:flex;align-items:center;justify-content:center}.m-promo p{margin:0}
.m-promo p{text-wrap:balance}

/* Project override (2026-11-11): SiteHeader (app/components/SiteHeader)
   now renders the header at every viewport, including mobile, so the
   prototype's own .m-head bar (with its old hand-traced logo mark) is a
   duplicate second header stacked on top of it. Hiding it here rather than
   editing PrototypePage/body.html, which must stay a verbatim copy of
   prototype/index.html per the Approach A rule. */
.m-head{display:none}
