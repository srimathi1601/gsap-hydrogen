}

/* ===== Row 3: product sticky bar ===== */

function ProductBar({product}) {
  return (
    <div className="sth-productbar">
      <div className="sth-container sth-productbar__inner">
        <span className="sth-pb__title">{product.title}</span>

        <div className="sth-pb__linkswrap">
          <nav className="sth-pb__links" aria-label="Produktabschnitte">
            {product.links.map((label) => (
              <Link to="#" key={label}>
                {label}
              </Link>
            ))}
          </nav>
        </div>

        <div className="sth-pb__right">
          <span className="sth-pb__old">{product.oldPrice}</span>
          <span className="sth-pb__new">{product.price}</span>
          <span className="sth-pb__save">{product.saving}</span>
          <button className="sth-pb__cta" type="button">
            {product.cta}
          </button>
        </div>
      </div>
    </div>
  );
}

function ChevronDown({className}) {
  return (
    <svg
      className={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2.2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  );
}

