}

function SearchButton({children}) {
  const {open} = useAside();

  return (
    <button
      className="sth-iconbtn"
      type="button"
      aria-label="Suche"
      onClick={() => open('search')}
    >
      {children}
    </button>
  );
}

/**
 * The reference design shows no count bubble, so the quantity is exposed to
 * assistive tech only and the icon stays pixel-identical.
 */
function CartButton({cart, children}) {
  const empty = <CartIcon count={0}>{children}</CartIcon>;

  return (
    <Suspense fallback={empty}>
      <Await resolve={cart} errorElement={empty}>
        <CartIconWithQuantity>{children}</CartIconWithQuantity>
      </Await>
    </Suspense>
  );
}

/** Only ever rendered inside <Await>, where useAsyncValue() has a value. */
function CartIconWithQuantity({children}) {
  const cart = useOptimisticCart(useAsyncValue());
  return <CartIcon count={cart?.totalQuantity ?? 0}>{children}</CartIcon>;
}

function CartIcon({count, children}) {
  const {open} = useAside();
  const {publish, shop, cart, prevCart} = useAnalytics();

  return (
    <button
      className="sth-iconbtn"
      type="button"
      aria-label={`Warenkorb (${count} Artikel)`}
      onClick={() => {
        open('cart');
        publish('cart_viewed', {
          cart,
          prevCart,
          shop,
          url: window.location.href || '',
        });
      }}
    >
      {children}
    </button>
  );
}

/** Drops the inline mark as soon as the real logo file resolves. */
