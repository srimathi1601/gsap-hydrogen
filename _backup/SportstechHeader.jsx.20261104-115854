      to="/"
      aria-label="Sportstech"
    >
      <img
        className="sth-logo__img"
        src={src}
        alt="Sportstech"
        width="257"
        height="42"
        onLoad={() => setHasImage(true)}
      />
      <svg
        className="sth-logo__svg"
        viewBox="0 0 257 42"
        width="257"
        height="42"
        aria-hidden="true"
      >
        <g fill="#0b0b0b">
          <rect
            x="0.25"
            y="6.75"
            width="33.5"
            height="11.5"
            rx="5.75"
            transform="rotate(-30 17 12.5)"
          />
          <rect
            x="1"
            y="25.75"
            width="25"
            height="12.5"
            rx="6.25"
            transform="rotate(-32 13.5 32)"
          />
        </g>
        <text
          x="39"
          y="29.5"
          textLength="217"
          lengthAdjust="spacingAndGlyphs"
          fontFamily="Inter, system-ui, sans-serif"
          fontSize="25"
          fontWeight="800"
          fontStyle="italic"
          fill="#0b0b0b"
        >
          SPORTSTECH
        </text>
      </svg>
    </Link>
  );
}

function LanguageSwitch() {
  const clipId = useId();

  return (
    <button
      className="sth-lang"
      type="button"
      aria-label="Sprache wählen: Deutsch"
    >
      <svg className="sth-flag" viewBox="0 0 22 22" aria-hidden="true">
        <defs>
          <clipPath id={clipId}>
            <circle cx="11" cy="11" r="11" />
          </clipPath>
        </defs>
        <g clipPath={`url(#${clipId})`}>
          <rect width="22" height="7.34" y="0" fill="#000" />
          <rect width="22" height="7.34" y="7.33" fill="#dd0000" />
          <rect width="22" height="7.34" y="14.66" fill="#ffce00" />
        </g>
      </svg>
      <span className="sth-lang__code">DE</span>
      <ChevronDown className="sth-chev sth-chev--lang" />
    </button>
