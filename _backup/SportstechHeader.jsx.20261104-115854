import {Suspense, useId, useState} from 'react';
import {Await, Link, useAsyncValue} from 'react-router';
import {useAnalytics, useOptimisticCart} from '@shopify/hydrogen';
import {useAside} from '~/components/Aside';
import {COUNTDOWN_TARGET, useCountdown} from '~/lib/useCountdown';

const NAV_ITEMS = [
  {label: 'Geräte', to: '#', hasMenu: true},
  {label: 'Nach Ziel', to: '#', hasMenu: true},
  {label: 'Sportstech Live', to: '#'},
  {label: 'Deals', to: '#'},
  {label: 'Ratgeber', to: '#'},
];

const PRODUCT_LINKS = [
  'Features',
  'Sportstech Live',
  'Bewertungen',
  'FAQ',
  'Technische Daten',
  'Service',
];

/**
 * Pixel clone of the Sportstech storefront header: promo bar, main nav and a
 * sticky product bar. Styles live in app/styles/sportstech-header.css.
 *
 * @param {{
 *   cart?: Promise<CartApiQueryFragment|null>;
 *   logoSrc?: string;
 *   menu?: {label: string, to: string, hasMenu?: boolean}[];
 *   countdownTarget?: string;
 *   product?: {
 *     title: string;
 *     links: string[];
 *     oldPrice: string;
 *     price: string;
 *     saving: string;
 *     cta: string;
 *   };
 * }}
 */
export function SportstechHeader({
  cart,
  logoSrc = '/logo.png',
  menu = NAV_ITEMS,
  countdownTarget = COUNTDOWN_TARGET,
  product = {
    title: 'sTread Pro Laufband',
    links: PRODUCT_LINKS,
    oldPrice: '2.758,80 €',
    price: '2.179 €',
    saving: '579,80 € gespart',
    cta: 'In den Warenkorb',
  },
}) {
  return (
    <>
      <header className="sth-site-header">
        <AnnouncementBar target={countdownTarget} />
        <MainBar cart={cart} logoSrc={logoSrc} menu={menu} />
      </header>

      {/*
        Outside <header> on purpose: position:sticky is bounded by its parent,
        so nested in the 206px header it would unstick after ~141px of scroll.
      */}
      <ProductBar product={product} />
    </>
  );
}

/* ===== Row 1: announcement bar ===== */

function AnnouncementBar({target}) {
  const {days, hours, minutes, seconds} = useCountdown(target);

  const units = [
    {value: days, unit: 'T'},
    {value: hours, unit: 'Std'},
    {value: minutes, unit: 'Min'},
    {value: seconds, unit: 'Sek'},
  ];

  return (
    <div className="sth-announce">
      <div className="sth-announce__inner">
        <span className="sth-announce__title">Oktober-Fit Days</span>
        <span className="sth-announce__dot" aria-hidden="true">
          ·
        </span>
        <span className="sth-announce__text">5 % sparen mit Code</span>
        <span className="sth-announce__code">Oktober5</span>

        <ul className="sth-countdown">
          {units.map(({value, unit}) => (
            <li className="sth-cd" key={unit}>
              {/* server and browser clocks differ by a tick on first paint */}
              <span className="sth-cd__num" suppressHydrationWarning>
                {value}
              </span>
              <span className="sth-cd__unit">{unit}</span>
            </li>
          ))}
        </ul>
      </div>

      <Link className="sth-announce__arrow" to="#" aria-label="Zum Angebot">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2"
          strokeLinecap="round"
          strokeLinejoin="round"
          aria-hidden="true"
        >
          <path d="M3 12h16.5" />
          <path d="m13 5 7 7-7 7" />
        </svg>
      </Link>
    </div>
  );
}

/* ===== Row 2: main header ===== */

function MainBar({cart, logoSrc, menu}) {
  return (
    <div className="sth-mainbar">
      <div className="sth-container sth-mainbar__inner">
        <Logo src={logoSrc} />

        <nav className="sth-nav" aria-label="Hauptnavigation">
          {menu.map(({label, to, hasMenu}) => (
            <Link className="sth-nav__link" to={to} key={label}>
              {label}
              {hasMenu && <ChevronDown className="sth-chev" />}
            </Link>
          ))}
        </nav>

        <div className="sth-actions">
          <LanguageSwitch />

          <SearchButton>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7.5" />
              <path d="m16.8 16.8 4.7 4.7" />
            </svg>
          </SearchButton>

          <Link
            className="sth-iconbtn"
            to="/account"
            prefetch="intent"
            aria-label="Konto"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="4.5" />
              <path d="M4.5 22.5a7.5 7.5 0 0 1 15 0" />
            </svg>
          </Link>

          <CartButton cart={cart}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              aria-hidden="true"
            >
              <path d="M5.5 7.5h13v14h-13z" />
              <path d="M8.5 7.5V5a3.5 3.5 0 0 1 7 0v2.5" />
            </svg>
          </CartButton>
        </div>
      </div>
    </div>
