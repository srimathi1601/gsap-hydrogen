/**
 * StreadProV2 — renders version2/index.html verbatim.
 *
 * Approach A (pdp-builder.md): a working prototype folder exists, so it is
 * copied, not rebuilt. Zero changes to HTML structure, CSS or animations;
 * the only edits (done by tools/sync-version2.mjs, never by hand) are
 * asset paths, plus one STEP-5 shader pre-warm line inside main.js.
 *
 * ── 2026-11-10 16:59: rebuilt for the current version2/ ────────────────
 * Until this rewrite, this component loaded version2/ as SEVEN classic
 * scripts (gsap, ScrollTrigger, lenis, sections.js, engine.js, app.js,
 * three3d.js) — that was the previous version2/'s shape (a variant of the
 * V1 prototype). That version2/ no longer exists on disk; it was replaced
 * (2026-11-10 16:26) with an unrelated Vite/Three.js ES-module package:
 * one bundle (js/main.js, ~842KB — GSAP+ScrollTrigger, Lenis, Three.js
 * r187 with GLTFLoader/DRACOLoader, and all page logic together), one
 * stylesheet, a GLB model + HDR environment, and no `#story`-adjacent
 * V1 markup at all — it has its own PDP gallery, scroll-pinned story
 * scenes, a Sportstech-Live tab section and a live 3D product viewer.
 *
 * So this component now loads exactly ONE `<script type="module">`
 * instead of a chain of seven. See _backup/StreadProV2.index.jsx.
 * 20261110-165909 for the retired multi-script version.
 *
 * The previous build (stread-pro-3d-source/ -> public/v2/, retired by
 * the earlier 2026-11-06 swap) is still untouched on disk, per
 * instruction not to touch stread-pro-3d-source/ files. This component
 * simply no longer references it.
 *
 * ── How the pieces fit ──────────────────────────────────────────────────
 * All of this is generated by tools/sync-version2.mjs. version2/ is the
 * source of truth and is never edited; re-run that script after it
 * changes.
 *
 *   body.html                    the <body> of version2/index.html,
 *                                 every relative asset path rewritten to
 *                                 /version2/…. Generated, committed.
 *                                 (No <script> to strip — version2's only
 *                                 script tag lives in <head>, not <body>.)
 *   public/version2/css/style.css        verbatim copy, linked by ./links.js.
 *   public/version2/js/main.js           copied, then path- and shader-
 *                                 pre-warm-patched — see sync-version2.mjs.
 *   public/version2/{img,vid,fonts,models,draco}/   copied verbatim.
 *   public/version2/studio.hdr           copied verbatim.
 *
 * The /version2/ prefix is not cosmetic: public/{img,models} already hold
 * other builds' assets, which are different files. Unprefixed, this page
 * would silently 404 or render the wrong images.
 *
 * ── #loader (STEP 4) ──────────────────────────────────────────────────
 * version2/css/style.css ALREADY contains, verbatim and unconditionally:
 *   #loader{display:none!important;opacity:0!important;visibility:hidden
 *   !important;pointer-events:none!important}
 * (with the author's own comment "hide starting loader visual only —
 * keep markup/JS"). So the loading screen is already hidden by the
 * copied-as-is stylesheet; no separate route-level CSS override was added,
 * to avoid a redundant duplicate rule fighting the source file.
 *
 * ── CSP (STEP 6) ────────────────────────────────────────────────────────
 * No change needed. app/entry.server.jsx's scriptSrc already has
 * 'wasm-unsafe-eval' + blob: (for the DRACOLoader wasm worker), workerSrc
 * and childSrc already have blob:, and mediaSrc already includes 'self'
 * — the video elements here are same-origin (/version2/vid/…), already
 * covered.
 *
 * ── Why the script is loaded by hand ─────────────────────────────────
 * innerHTML never executes <script> elements, so the markup alone is
 * inert; main.js has to be appended as a real <script> element.
 */

import {useEffect} from 'react';
import bodyHtml from './body.html?raw';

export {links} from './links.js';

const MODULE_SCRIPT = '/version2/js/main.js';

/** Appends one <script type="module"> and resolves when it has executed. */
function loadScript(src) {
  return new Promise((resolve, reject) => {
    const existing = document.querySelector(`script[data-v2="${src}"]`);
    if (existing) {
      resolve();
      return;
    }
    const el = document.createElement('script');
    el.type = 'module';
    el.crossOrigin = 'anonymous'; // matches version2/index.html's own
    // `crossorigin` attribute and links.js's modulepreload, so this keys
    // to the same cache entry instead of double-fetching
    el.src = src;
    el.dataset.v2 = src;
    el.onload = () => resolve();
    el.onerror = () => reject(new Error(`Failed to load ${src}`));
    document.body.appendChild(el);
  });
}

/* Module scope, so version2 boots exactly once per page load.
   `loadScript` is also idempotent (it checks for data-v2), so an HMR
   module re-evaluation that resets this flag still cannot double-load. */
let booted = false;

export function StreadProV2() {
  useEffect(() => {
    if (booted) return;
    booted = true;

    // NO cancellation flag here, deliberately — same reasoning as the
    // previous version of this component: React 18 StrictMode runs an
    // effect, tears it down, then runs it again. Booting version2 is a
    // one-shot global side effect on the document, not component-scoped
    // work, so there is nothing to cancel; a cancellation flag here would
    // only risk the chain short-circuiting on the real run.
    loadScript(MODULE_SCRIPT).catch((err) => {
      booted = false;
      console.error('[StreadProV2] module script failed:', err);
    });
  }, []);

  return (
    <div
      className="v2-root"
      // main.js rewrites/populates this subtree as soon as it runs (the
      // gallery track, Sportstech-Live tabs, etc. are built from JS), so
      // the client DOM intentionally diverges from the server markup.
      suppressHydrationWarning
      // The markup is version2/index.html's own <body>, read from disk at
      // build time — not user input.
      dangerouslySetInnerHTML={{__html: bodyHtml}}
    />
  );
}

export default StreadProV2;
