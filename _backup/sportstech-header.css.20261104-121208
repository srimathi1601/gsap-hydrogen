/* ============================================================
   Sportstech header - rendered by components/SportstechHeader.jsx
   Reference: reference/navbar.png (measurements target a 1900px viewport).
   Every class is sth-* prefixed so nothing collides with reset.css,
   app.css or Tailwind utilities.
   ============================================================ */

.sth-announce,
.sth-mainbar,
.sth-productbar {
  --sth-beige:        #f7f1ea;  /* row 2 + row 3 background */
  --sth-hairline:     #e5dfd8;  /* 1px divider above the product bar */
  --sth-nav-ink:      #4a4a4a;
  --sth-icon-ink:     #111;
  --sth-title-ink:    #222;
  --sth-pblink-ink:   #5a5a5a;
  --sth-price-old:    #6f6a62;
  --sth-price-new:    #111;
  --sth-save-bg:      #dee3ec;
  --sth-save-ink:     #0b6bff;
  --sth-cta-bg:       #0b6bff;
  --sth-cta-bg-hover: #0858d6;
}

/* ------------------------------------------------------------
   Local resets. reset.css, app.css and Tailwind preflight all
   reach into these elements, so the component re-states what it
   depends on instead of inheriting whatever the page happens to set.
   ------------------------------------------------------------ */
.sth-announce,
.sth-mainbar,
.sth-productbar {
  flex: none;            /* body is a flex column in reset.css */
  font-family: Inter, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.sth-announce a,
.sth-mainbar a,
.sth-productbar a { text-decoration: none; }

.sth-announce a:hover,
.sth-mainbar a:hover,
.sth-productbar a:hover { text-decoration: none; }

.sth-cd { margin-bottom: 0; }      /* reset.css gives every li a margin */
.sth-logo__img { border-radius: 0; }  /* app.css rounds every img */

/* Content column: 1600px of content, 150px gutters => 150 ... 1750 at 1900px */
.sth-container {
  box-sizing: content-box;
  max-width: 1600px;
  margin-inline: auto;
  padding-inline: 150px;
}

/* ============================================================
   Row 1 - announcement bar (51px)
   ============================================================ */
.sth-announce {
  position: relative;
  height: 51px;
  /* Reference shows a centred navy glow, not a left-to-right ramp. */
  background: radial-gradient(ellipse 620px 150px at 50% 50%, #3156a6 0%, #0d1b36 100%);
  color: #fff;
  overflow: hidden;
}

.sth-announce__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  height: 100%;
  /* Reference optical centre sits ~17px left of the page centre and ~2px high. */
  padding-right: 34px;
  padding-bottom: 4px;
}

.sth-announce__title {
  font-size: 17px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.sth-announce__dot {
  color: rgba(255, 255, 255, 0.55);
  font-size: 16px;
}

.sth-announce__text {
  font-size: 17px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.sth-announce__code {
  font-size: 17px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  line-height: 18px;
  border: 1px dashed rgba(255, 255, 255, 0.85);
  border-radius: 6px;
  padding: 4px 13px;
}

.sth-countdown {
  display: flex;
  gap: 8px;
  margin: 0 0 0 20px;
  padding: 0;
  list-style: none;
}

.sth-cd {
  display: flex;
  align-items: baseline;
  gap: 5px;
  background: rgba(255, 255, 255, 0.13);
  border-radius: 8px;
  padding: 6px 10px;
}

.sth-cd__num {
  font-size: 18px;
  font-weight: 700;
  line-height: 19px;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.sth-cd__unit {
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
}

.sth-announce__arrow {
  position: absolute;
  top: 50%;
  right: 120px;          /* icon box ends at x=1780 on a 1900px viewport */
  transform: translateY(-50%);
  margin-top: -2px;
  display: flex;
  width: 18px;
  height: 18px;
  color: #fff;
}
.sth-announce__arrow svg { width: 18px; height: 18px; }

/* ============================================================
   Row 2 - main header (90px)
   ============================================================ */
.sth-mainbar {
  height: 90px;
  background: var(--sth-beige);
}

.sth-mainbar__inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.sth-logo { display: flex; align-items: center; }
.sth-logo__img,
.sth-logo__svg { display: block; width: 257px; height: 42px; }
/* The inline mark is the fallback: it hides as soon as logo.png loads. */
.sth-logo__img { display: none; }
.sth-logo--has-img .sth-logo__img { display: block; }
.sth-logo--has-img .sth-logo__svg { display: none; }

/* Nav is centred on the page, independent of the logo / action widths. */
.sth-nav {
  position: absolute;
  left: 50%;
  top: 50%;
  /* The reference sets the links ~5px above the band's true centre. */
  transform: translate(-50%, calc(-50% - 5px));
  display: flex;
  align-items: center;
  gap: 50px;
}

.sth-nav__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 20px;
  font-weight: 400;
  color: var(--sth-nav-ink);
  text-decoration: none;
  white-space: nowrap;
}
.sth-nav__link:hover { color: #000; }

.sth-chev { width: 14px; height: 14px; flex: none; }

.sth-actions {
  display: flex;
  align-items: center;
  gap: 34px;
  margin-right: 15px;   /* action row ends at x=1735 */
}

.sth-lang {
  display: flex;
  align-items: center;
  gap: 8px;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  color: var(--sth-icon-ink);
  font-family: inherit;
}
.sth-flag { width: 22px; height: 22px; display: block; }
.sth-lang__code { font-size: 18px; font-weight: 400; color: var(--sth-icon-ink); }
.sth-chev--lang { width: 14px; height: 14px; }

.sth-iconbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  padding: 0;
  border: 0;
  background: none;
  cursor: pointer;
  color: var(--sth-icon-ink);
}
.sth-iconbtn svg { width: 24px; height: 24px; display: block; }

/* ============================================================
   Row 3 - product sticky bar (65px)
   ============================================================ */
.sth-productbar {
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
  height: 65px;
  padding-top: 6px;   /* matches the optical centre in the reference (y~176.5) */
  background: var(--sth-beige);
  border-top: 1px solid var(--sth-hairline);
}

.sth-productbar__inner {
  display: flex;
  align-items: center;
  height: 100%;
}

.sth-pb__title {
  font-size: 22px;
  letter-spacing: 0.15px;
  font-weight: 500;
  color: var(--sth-title-ink);
  margin-right: 40px;
  white-space: nowrap;
}

/* The link row is clipped on the right and fades into the bar. */
.sth-pb__linkswrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 0;
  margin-right: 40px;
  overflow: hidden;
}
.sth-pb__linkswrap::after {
  content: "";
  position: absolute;
  inset: 0 0 0 auto;
  width: 28px;
  background: linear-gradient(to right, rgba(247, 241, 234, 0), var(--sth-beige));
  pointer-events: none;
}

.sth-pb__links {
  display: flex;
  gap: 35px;
  white-space: nowrap;
}
.sth-pb__links a {
  font-size: 18px;
  color: var(--sth-pblink-ink);
  text-decoration: none;
}
.sth-pb__links a:hover { color: #111; }

.sth-pb__right {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: auto;
  flex: none;
}

.sth-pb__old {
  font-size: 18px;
  color: var(--sth-price-old);
  text-decoration: line-through;
}
.sth-pb__new {
  font-size: 23px;
  font-weight: 700;
  color: var(--sth-price-new);
}
.sth-pb__save {
  display: inline-flex;
  align-items: center;
  height: 28px;
  padding: 0 11px;
  border-radius: 999px;
  background: var(--sth-save-bg);
  color: var(--sth-save-ink);
  font-size: 17px;
  font-weight: 600;
}
.sth-pb__cta {
  margin-left: 28px;   /* reference gap from the badge is ~40px */
  height: 46px;
  padding: 0 24px;
  border: 0;
  border-radius: 999px;
  background: var(--sth-cta-bg);
  color: #fff;
  font-family: inherit;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
}
.sth-pb__cta:hover { background: var(--sth-cta-bg-hover); }

/* ============================================================
   Responsive
   ============================================================ */
@media (max-width: 1400px) {
  .sth-container { padding-inline: 60px; }  /* keep the promo line clear of the arrow once the gutters shrink */
  .sth-announce__arrow { right: 40px; }
  .sth-announce__inner { padding-left: 30px; padding-right: 70px; }
}

@media (max-width: 1100px) {
  .sth-nav,
  .sth-pb__linkswrap { display: none; }
  .sth-container { padding-inline: 24px; }
  .sth-announce__inner { gap: 8px; padding-left: 24px; padding-right: 56px; }
  .sth-announce__arrow { right: 24px; }
  .sth-announce__title,
  .sth-announce__text,
  .sth-announce__code { font-size: 14px; }
  .sth-announce__code { padding: 4px 10px; }
  .sth-countdown { gap: 6px; margin-left: 12px; }
  .sth-cd { gap: 4px; padding: 5px 8px; }
  .sth-cd__num { font-size: 16px; }
  .sth-cd__unit { font-size: 12px; }

  .sth-pb__title { margin-right: 24px; }
}

@media (max-width: 900px) {
  /* the price block no longer fits beside the title and the button */
  .sth-pb__old,
  .sth-pb__save { display: none; }

  .sth-announce__title,
  .sth-announce__text,
  .sth-announce__code { font-size: 13px; }
  .sth-cd { padding: 4px 7px; }
  .sth-cd__num { font-size: 15px; }
  .sth-cd__unit { font-size: 11px; }
}

@media (max-width: 700px) {
  .sth-countdown { display: none; }
  .sth-announce__inner { gap: 8px; }
  .sth-pb__title {
    font-size: 18px;
    margin-right: 16px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sth-pb__cta { margin-left: 12px; padding: 0 16px; font-size: 16px; }
}

@media (max-width: 560px) {
  /* phone: drop the promo sentence and the language switch, shrink the mark */
  .sth-announce__text { display: none; }
  .sth-logo__img,
  .sth-logo__svg { width: 180px; height: 30px; }
  .sth-lang { display: none; }
  .sth-actions { gap: 20px; margin-right: 0; }
  .sth-pb__new { font-size: 20px; }
  .sth-pb__cta { height: 42px; font-size: 15px; }
}

@media (max-width: 380px) {
  .sth-logo__img,
  .sth-logo__svg { width: 160px; height: 26px; }
  .sth-actions { gap: 18px; }
}
