/**
 * StreadProV2 — renders version2/index.html verbatim.
 *
 * Approach A (pdp-builder.md): a working prototype folder exists, so it is
 * copied, not rebuilt. Zero changes to HTML structure, CSS, animations or
 * assets; the only edits are asset paths and script order, both of which
 * Approach A explicitly allows.
 *
 * This is the same shape as app/sections/PrototypePage/index.jsx (the V1
 * home route) and deliberately so — version2/ is the same KIND of thing as
 * prototype/, so the mount is the same.
 *
 * ── What version2/ is, and what it replaced here ──────────────────────
 * Until 2026-11-10 this component mounted the Three.js/Vite project in
 * stread-pro-3d-source/ as ONE pre-built ES-module bundle
 * (/v2/assets/index-D2EHI1jo.js) with its own hashed stylesheet.
 *
 * version2/ is NOT that project. Verified by hash: its sections.js,
 * engine.js, three3d.js, gsap/lenis/ScrollTrigger and stread-pro.glb are
 * byte-identical to prototype/; only app.js, index.html and css/site.css
 * differ. It is a classic-script, engine.js-driven page with V1's own
 * section ids (#top #s3d #kf #live #vid) and `.pinbox` / `.dstat` hosts —
 * so it loads as seven classic scripts plus one module, exactly like
 * PrototypePage, and NOT as a single bundle.
 *
 * The previous Vite build is untouched on disk (public/v2/,
 * stread-pro-3d-source/) and the replaced files are in _backup/
 * *.v2swap.20261110-145425, so this is reversible.
 *
 * ── How the pieces fit ────────────────────────────────────────────────
 * All of this is generated by tools/sync-version2.mjs. version2/ is the
 * source of truth and is never edited; re-run that script after it
 * changes.
 *
 *   body.html                    the <body> of version2/index.html with
 *                                every <script> stripped and every
 *                                relative asset path rewritten to
 *                                /version2/…. Generated, committed.
 *   public/version2/js/*         version2/js/* copied, with four edits:
 *                                  app.js      url(fig/ url(img/
 *                                                -> /version2/fig/ /img/
 *                                  engine.js   url(fig/ -> /version2/fig/
 *                                  three3d.js  'three' -> relative,
 *                                                draco + GLB -> /version2/,
 *                                                r.compile() (STEP 5)
 *                                and the six three addons' bare 'three'
 *                                specifier rewritten to
 *                                '../../three.module.js'.
 *   public/version2/js/faq.js    the window.FAQ block that was inline in
 *                                version2/index.html — an inline <script>
 *                                inside injected HTML never executes, so
 *                                it is a file now. app.js reads FAQ[i]
 *                                while building the accordion, so it must
 *                                load first.
 *   public/version2/css/*        site.css + mobile.css, verbatim, linked
 *                                by ./links.js. NOT appended to
 *                                app/styles/app.css — see links.js for
 *                                why.
 *   public/version2/{img,fig,fonts,models}/   copied verbatim.
 *
 * The /version2/ prefix is not cosmetic: public/{img,fig,models} already
 * hold the V1 prototype's assets, which are DIFFERENT files. Unprefixed,
 * version2 would silently render V1's images.
 *
 * ── Why the scripts are loaded by hand ────────────────────────────────
 * innerHTML never executes <script> elements, so the markup alone is
 * inert. The chain below recreates version2/index.html's own load order
 * (its lines 46-49), which differs from the V1 prototype's only in where
 * the FAQ block sits — first here, rather than after sections.js:
 *
 *   faq → gsap → ScrollTrigger → lenis → sections → engine → app
 *
 * gsap and ScrollTrigger come before app.js because its first line is
 * `gsap.registerPlugin(ScrollTrigger)`; sections.js defines
 * window.SECTIONS and engine.js defines window.buildStage /
 * window.mountPinned, both of which app.js consumes immediately; faq.js
 * defines window.FAQ, which app.js reads while building the accordion.
 * three3d.js is an ES module and is loaded last — nothing else depends on
 * it.
 *
 * ── Known constraint ──────────────────────────────────────────────────
 * The prototype scripts are global and not idempotent: they register
 * ScrollTriggers, a Lenis instance and window-level listeners with no
 * teardown. They therefore run ONCE per full page load. If you client-side
 * navigate away and back, the markup returns but the behaviour does not —
 * reload the page. Making that work would mean rewriting version2's JS,
 * which is the opposite of the point of this component.
 */

import {useEffect} from 'react';
import bodyHtml from './body.html?raw';

export {links} from './links.js';

/* Classic scripts, in version2/index.html's own order. */
const SCRIPTS = [
  '/version2/js/faq.js',
  '/version2/js/gsap.min.js',
  '/version2/js/ScrollTrigger.min.js',
  '/version2/js/lenis.min.js',
  '/version2/js/sections.js',
  '/version2/js/engine.js',
  '/version2/js/app.js',
];

const MODULE_SCRIPT = '/version2/js/three3d.js';

/** Appends one <script> and resolves when it has executed. */
function loadScript(src, {module = false} = {}) {
  return new Promise((resolve, reject) => {
    const existing = document.querySelector(`script[data-v2="${src}"]`);
    if (existing) {
      resolve();
      return;
    }
    const el = document.createElement('script');
    el.src = src;
    el.async = false; // preserve execution order
    el.dataset.v2 = src;
    if (module) el.type = 'module';
    el.onload = () => resolve();
    el.onerror = () => reject(new Error(`Failed to load ${src}`));
    document.body.appendChild(el);
  });
}

/**
 * version2's scripts run during initial parse, so they can register
 * one-shot lifecycle listeners and expect them to fire. Loaded from a React
 * effect they run much later, and `window.load` has usually gone already:
 *
 *   version2/js/app.js, last line:
 *     document.fonts.ready.then(() => { fitTexts(); ScrollTrigger.refresh() });
 *     addEventListener('load', () => ScrollTrigger.refresh());
 *
 * `document.fonts.ready` is a promise, so that half always resolves. The
 * `load` listener does not: if the event already fired, every pinned
 * ScrollTrigger keeps the start/end it measured at create() time — before
 * images and fonts settled — which shows up as pins engaging at the wrong
 * scroll offset and stretches of empty space, worst on mobile where
 * .m-sec heights depend most on reflow.
 *
 * So: if `load` has been and gone, call the refresh ourselves.
 *
 * `window.stRefresh` is the V1 prototype's coalescing queue; version2's
 * app.js does not define one, so this falls through to ScrollTrigger's own
 * refresh there.
 */
function replayMissedLifecycleHooks() {
  const refresh = () =>
    window.stRefresh ? window.stRefresh() : window.ScrollTrigger?.refresh();
  if (document.readyState === 'complete') refresh();
  else window.addEventListener('load', refresh, {once: true});
  // Belt and braces: refresh once more after webfonts have swapped in.
  document.fonts?.ready?.then(refresh);
}

/* Module scope, so version2 boots exactly once per page load.
   `loadScript` is also idempotent (it checks for data-v2), so an HMR
   module re-evaluation that resets this flag still cannot double-load. */
let booted = false;

export function StreadProV2() {
  useEffect(() => {
    if (booted) return;
    booted = true;

    // NO cancellation flag here, deliberately.
    //
    // React 18 StrictMode runs an effect, tears it down, then runs it
    // again. An earlier version of PrototypePage set `cancelled = true` in
    // the cleanup and checked it between links of the chain. The result
    // was:
    //   run 1  -> booted = true, chain starts
    //   cleanup-> cancelled = true
    //   run 2  -> `booted` already true, returns immediately
    //   chain  -> every remaining .then() short-circuits
    // so only the first script ever loaded, app.js never ran, and every
    // desktop section stayed an empty .pinbox — a white page.
    //
    // Booting version2 is a one-shot global side effect on the document,
    // not component-scoped work, so there is nothing to cancel.
    SCRIPTS.reduce(
      (chain, src) => chain.then(() => loadScript(src)),
      Promise.resolve(),
    )
      .then(replayMissedLifecycleHooks)
      // ES module; nothing else depends on it, so it goes last.
      .then(() => loadScript(MODULE_SCRIPT, {module: true}))
      .catch((err) => {
        booted = false;
        console.error('[StreadProV2] script chain failed:', err);
      });
  }, []);

  return (
    <div
      className="v2-root"
      // version2/js/app.js rewrites this subtree as soon as it runs
      // (buildStage/mountPinned replace the empty .pinbox hosts), so the
      // client DOM intentionally diverges from the server markup.
      suppressHydrationWarning
      // The markup is version2/index.html's own <body>, read from disk at
      // build time — not user input.
      dangerouslySetInnerHTML={{__html: bodyHtml}}
    />
  );
}

export default StreadProV2;
